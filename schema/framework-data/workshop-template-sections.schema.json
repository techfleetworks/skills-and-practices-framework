{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://techfleetworks.github.io/skills-and-practices-framework/schema/framework-data/workshop-template-sections.schema.json",
  "title": "workshop-template-sections",
  "description": "A record in the workshop-template-sections dataset of the Skills & Practices Framework. Field names are the framework's own; see schema/context.jsonld for the schema.org / SKOS mapping.",
  "type": "object",
  "required": [
    "slug"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "integer"
    },
    "slug": {
      "type": "string"
    },
    "Unique ID": {
      "type": "number"
    },
    "Workshop": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "slug": {
            "type": "string"
          },
          "label": {
            "type": "string"
          }
        },
        "required": [
          "slug",
          "label"
        ],
        "additionalProperties": false
      }
    },
    "Order": {
      "type": "string"
    },
    "Section / Prompt": {
      "type": "string"
    },
    "What Goes Here": {
      "type": "string"
    }
  }
}