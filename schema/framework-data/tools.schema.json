{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://techfleetworks.github.io/skills-and-practices-framework/schema/framework-data/tools.schema.json",
  "title": "tools",
  "description": "A record in the tools dataset of the Skills & Practices Framework. Field names are the framework's own; see schema/context.jsonld for the schema.org / SKOS mapping.",
  "type": "object",
  "required": [
    "slug"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "integer"
    },
    "slug": {
      "type": "string"
    },
    "Tool Name": {
      "type": "string"
    },
    "Data Type": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "slug": {
            "type": "string"
          },
          "label": {
            "type": "string"
          }
        },
        "required": [
          "slug",
          "label"
        ],
        "additionalProperties": false
      }
    },
    "Tool URL": {
      "type": "string"
    },
    "Tool Logo": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "url": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "Category": {
      "type": "string"
    },
    "Tool Description": {
      "type": "string"
    },
    "Tool Features": {
      "type": "string"
    },
    "Tool Direct Competitors": {
      "type": "string"
    },
    "Common Tasks Using the Tool": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "slug": {
            "type": "string"
          },
          "label": {
            "type": "string"
          }
        },
        "required": [
          "slug",
          "label"
        ],
        "additionalProperties": false
      }
    },
    "Roles": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "slug": {
            "type": "string"
          },
          "label": {
            "type": "string"
          }
        },
        "required": [
          "slug",
          "label"
        ],
        "additionalProperties": false
      }
    },
    "Where Can I Learn More?": {
      "type": "string"
    },
    "Deliverables": {
      "type": "string"
    }
  }
}