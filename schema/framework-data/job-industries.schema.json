{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://techfleetworks.github.io/skills-and-practices-framework/schema/framework-data/job-industries.schema.json",
  "title": "job-industries",
  "description": "A record in the job-industries dataset of the Skills & Practices Framework. Field names are the framework's own; see schema/context.jsonld for the schema.org / SKOS mapping.",
  "type": "object",
  "required": [
    "slug"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "integer"
    },
    "slug": {
      "type": "string"
    },
    "Job Industry Name": {
      "type": "string"
    },
    "Transferrable Technical Skills Coming From This Industry": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "slug": {
            "type": "string"
          },
          "label": {
            "type": "string"
          }
        },
        "required": [
          "slug",
          "label"
        ],
        "additionalProperties": false
      }
    },
    "Common Job Titles Within This Industry": {
      "type": "string"
    },
    "Transferrable Interpersonal Skills Coming From This Industry": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "slug": {
            "type": "string"
          },
          "label": {
            "type": "string"
          }
        },
        "required": [
          "slug",
          "label"
        ],
        "additionalProperties": false
      }
    }
  }
}