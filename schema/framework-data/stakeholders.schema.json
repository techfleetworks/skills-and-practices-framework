{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://techfleetworks.github.io/skills-and-practices-framework/schema/framework-data/stakeholders.schema.json",
  "title": "stakeholders",
  "description": "A record in the stakeholders dataset of the Skills & Practices Framework. Field names are the framework's own; see schema/context.jsonld for the schema.org / SKOS mapping.",
  "type": "object",
  "required": [
    "slug"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "integer"
    },
    "slug": {
      "type": "string"
    },
    "Name": {
      "type": "string"
    },
    "Relevant Company Types": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "slug": {
            "type": "string"
          },
          "label": {
            "type": "string"
          }
        },
        "required": [
          "slug",
          "label"
        ],
        "additionalProperties": false
      }
    },
    "Deliverables": {
      "type": "string"
    },
    "Workshops": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "slug": {
            "type": "string"
          },
          "label": {
            "type": "string"
          }
        },
        "required": [
          "slug",
          "label"
        ],
        "additionalProperties": false
      }
    }
  }
}