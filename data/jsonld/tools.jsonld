    {
      "id": "spf:github",
      "type": [
        "schema:SoftwareApplication",
        "spf:Tool",
        "skos:Concept"
      ],
      "Tool Name": "GitHub",
      "Data Type": [
        {
          "id": "spf:tool",
          "label": "Tool"
        }
      ],
      "Tool URL": "https://github.com",
      "Category": "Development",
      "Tool Description": "GitHub is where developers store, share, and manage code together. It tracks every change, lets people review each other's work, and keeps a full history, which makes it possible for a whole team to build the same software without overwriting each other.",
