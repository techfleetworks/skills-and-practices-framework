      "Duty Who Owns the Deliverable": [
        {
          "id": "spf:solutions-architecture",
          "label": "Solutions Architecture"
        }
      ],
      "Deliverable Description": "A system architecture diagram is a picture of how the major parts of a product fit and talk to each other, like the front end, back end, and databases. It gives everyone a shared map of the technical structure.",
      "Why Is This Deliverable Important?": "It helps the team spot problems and plan how things will scale before a single line of code is locked in, saving painful rework later.",
      "How Does This Deliverable Relate to Other Deliverables?": "It is created in Requirements, guides the more detailed architecture specs and diagrams, and shapes how developers build in the Implement milestone.",
      "Where Can I Learn More?": "MDN Web Docs, a trusted resource for building software: https://developer.mozilla.org/en-US/docs/Learn",
      "Hand-Off Deliverables Map": [
        {
          "id": "spf:part-3-the-outcomes",
          "label": "Part 3: The outcomes"
        }
      ]
    },
