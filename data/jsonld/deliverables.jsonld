      ],
      "Deliverable Description": "A user story is a short description of a need from the user's point of view, usually in the form of who wants what and why. It keeps the focus on the person using the product, not just the feature.",
      "Why Is This Deliverable Important?": "Stories turn big requirements into small, buildable pieces the team can pick up one at a time, which is the heartbeat of agile delivery.",
      "How Does This Deliverable Relate to Other Deliverables?": "They come from the Requirements milestone, carry acceptance criteria, and fill the backlog the team works through sprint by sprint.",
      "Where Can I Learn More?": "Atlassian Agile Coach, with guides on agile, Scrum, and Kanban: https://www.atlassian.com/agile",
      "Hand-Off Deliverables Map": [
        {
          "id": "spf:part-1-empathy-building",
          "label": "Part 1: Empathy Building"
        }
      ]
    },
